# The three folders are independent packages with their own ignore files. This
# one only covers what sits at the root or would otherwise be missed everywhere.

.DS_Store
node_modules/

# The packaged app and its DMG. Large, machine-specific, and rebuilt from source
# by anyone who clones this — but not scratch: this is where the installed app
# lives, so never suggest deleting it wholesale.
release/

# Secrets, wherever they end up. Each package already ignores its own, but a new
# folder shouldn't have to remember to.
.env
.env.local
!.env.example
!.env.local.example
