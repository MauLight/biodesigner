# Copy to .env. Only OPENAI_API_KEY has no default — the rest are here to be
# seen rather than to be changed.

# Required. Never committed: .env is ignored, this file is the record that the
# variable exists.
OPENAI_API_KEY=sk-...

PORT=4000

# The conversation model. gpt-4o-mini is the code default but loses the
# artifact-reframe test — it accepts "design a better water bottle" as a
# challenge instead of pushing back on it.
OPENAI_MODEL=gpt-5.6-luna

# Compresses each turn into one ledger line. A small model is enough, and this
# call happens twice per exchange, so it is the one worth keeping cheap.
# Defaults to OPENAI_MODEL when unset.
OPENAI_SUMMARY_MODEL=gpt-5-nano

# Where session JSON files are written, relative to back-end/. Ignored by git:
# these are transcripts of the user's own design work.
DATA_DIR=./data

# The front-end's origin. Comma-separated for more than one.
CORS_ORIGIN=http://localhost:3000
